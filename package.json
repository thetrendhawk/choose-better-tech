{
  "name": "choose-better-tech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm audit --audit-level=low && npm test && npm run lint && node scripts/generate-seo-files.mjs && node scripts/generate-vercel-routes.mjs && tsc -b && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/entry-server.tsx --outDir .prerender/server --emptyOutDir && node scripts/prerender-routes.mjs",
    "check:static-output": "node scripts/validate-static-output.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:routing": "node scripts/check-routing.mjs",
    "check:visual": "node scripts/check-visuals.mjs",
    "update:visual": "set UPDATE_VISUAL_BASELINES=1&& node scripts/check-visuals.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:site": "node scripts/audit-site.mjs",
    "generate:routes": "node scripts/generate-vercel-routes.mjs",
    "check:generated-routes": "node scripts/check-generated-routes.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "vitest": "^4.1.11"
  }
}
